{
  "name": "TechCrate-mobile",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "bundle:android": "npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/ --reset-cache",
    "preandroid": "npm run bundle:android",
    "android": "npx react-native run-android",
    "build": "npm run bundle:android && cd android && gradlew.bat assembleRelease",
    "build:android": "npm run bundle:android && cd android && gradlew.bat assembleRelease",
    "build:debug": "npm run bundle:android && cd android && gradlew.bat assembleDebug --no-daemon",
    "build:bundle": "npm run bundle:android && cd android && gradlew.bat bundleRelease",
    "ios": "npx react-native run-ios",
    "lint": "eslint .",
    "start": "npx react-native start",
    "start:reset": "npx react-native start --reset-cache",
    "start:8082": "npx react-native start --port 8082",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/drawer": "^7.1.1",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/stack": "^7.1.1",
    "axios": "^1.7.9",
    "date-fns": "^4.1.0",
    "lodash": "^4.17.21",
    "lucide-react-native": "^1.52.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "^2.21.2",
    "react-native-image-picker": "^7.1.2",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-modal": "^13.0.1",
    "react-native-paper": "^5.12.5",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.4.0",
    "react-native-svg": "^15.11.2",
    "react-native-toast-message": "^2.2.1",
    "react-native-vector-icons": "^10.2.0",
    "react-native-worklets": "^0.13.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
