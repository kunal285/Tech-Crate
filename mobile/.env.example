# TechCrate React Native Mobile App Environment Template
# Production API Configuration:
EXPO_PUBLIC_API_URL=https://api.example.com/api
# Local Development API Configuration (10.0.2.2 for Android emulator, localhost for iOS simulator):
API_BASE_URL=http://10.0.2.2:5000/api

# ==============================================================================
# FIREBASE PHONE AUTHENTICATION CONFIGURATION
# (Obtain these from Firebase Console -> Project Settings -> General -> Your Apps)
# ==============================================================================
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
