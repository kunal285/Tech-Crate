# ProjectKart Backend Environment Template Example
PORT=5000
NODE_ENV=development

# Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/projectkart

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# AI Assistant Key
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================================================================
# FIREBASE ADMIN SDK CONFIGURATION (FOR VERIFYING FIREBASE PHONE AUTH ID TOKENS)
# ==============================================================================
# Option 1: Individual Firebase Service Account credentials
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option 2: Full JSON Service Account string or file path
# FIREBASE_SERVICE_ACCOUNT_KEY=./config/serviceAccountKey.json

# ==============================================================================
# REAL SMS OTP GATEWAY PROVIDER CONFIGURATION (FALLBACK / DIRECT SMS)
# (Configure ONE of the providers below for sending real SMS OTPs)
# ==============================================================================

# Option 1: Fast2SMS (Recommended for India — Quick & OTP Route)
FAST2SMS_API_KEY=your_fast2sms_api_key

# Option 2: Twilio (Global / International / India)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Option 3: MSG91 (DLT Compliant in India)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_otp_template_id

