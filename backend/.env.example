# TechCrate Backend Environment Template Example
PORT=5000
NODE_ENV=development

# Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/TechCrate

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Payment Gateway Configuration
PAYMENT_API_KEY=key_live_techcrate_2026
PAYMENT_SECRET_KEY=sec_live_techcrate_2026
PAYMENT_WEBHOOK_SECRET=whsec_techcrate_2026
PAYMENT_DEFAULT_REDIRECT_URL=myapp://payment/success
PAYMENT_SUCCESS_REDIRECT_URL=myapp://payment/success
PAYMENT_FAILED_REDIRECT_URL=myapp://payment/failed
PAYMENT_GLOBAL_WEBHOOK_URL=http://localhost:5000/api/webhooks/payment

# Auto UPI Gateway (https://autoupigateway.com)
AUTO_UPI_GATEWAY_URL=https://autoupigateway.com
AUTO_UPI_USER_TOKEN=your_auto_upi_user_token_here
AUTO_UPI_WEBHOOK_SECRET=your_auto_upi_webhook_secret_here

# AI Assistant Key
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================================================================
# FIREBASE ADMIN SDK CONFIGURATION (FOR VERIFYING FIREBASE PHONE AUTH ID TOKENS)
# ==============================================================================
# Option 1: Individual Firebase Service Account credentials
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# ENTERPRISE CACHE, QUEUE, OBSERVABILITY & DATABASE CONFIGURATION
# ==============================================================================
REDIS_URL=redis://127.0.0.1:6379
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_backend_only

POSTHOG_API_KEY=phc_your_posthog_project_api_key
POSTHOG_HOST=https://app.posthog.com
