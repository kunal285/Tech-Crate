{
  "name": "TechCrate-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "TechCrate — Full-Stack AI-Powered Student & Maker E-Commerce Platform",
  "scripts": {
    "build": "echo 'Backend ready - no build step required'",
    "start:backend": "npm --prefix backend start",
    "dev:backend": "npm --prefix backend run dev",
    "start:admin": "npm --prefix admin run dev",
    "build:admin": "npm --prefix admin run build",
    "dev:website": "npm --prefix website run dev",
    "build:website": "npm --prefix website run build",
    "start:website": "npm --prefix website start",
    "start:mobile": "npm --prefix mobile start",
    "start:mobile:8082": "npm --prefix mobile run start:8082",
    "test": "npm --prefix backend test",
    "test:checkout": "npm --prefix backend run test:checkout",
    "test:mobile": "npm --prefix mobile test",
    "android": "npm run android:mobile",
    "android:mobile": "npm --prefix mobile run android"
  }
}